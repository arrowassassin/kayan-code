{
  "visible": [
    { "input": [[-1,0,1,2,-1,-4]], "expected": [[-1,-1,2],[-1,0,1]] },
    { "input": [[0,1,1]], "expected": [] },
    { "input": [[0,0,0]], "expected": [[0,0,0]] }
  ],
  "hidden": [
    { "input": [[]], "expected": [] },
    { "input": [[1,2]], "expected": [] },
    { "input": [[0,0,0,0]], "expected": [[0,0,0]] },
    { "input": [[-2,0,1,1,2]], "expected": [[-2,0,2],[-2,1,1]] },
    { "input": [[-1,-1,-1,2]], "expected": [[-1,-1,2]] },
    { "input": [[3,-2,1,0]], "expected": [] },
    { "input": [[-4,-2,-2,0,1,2,2,3,4]], "expected": [[-4,0,4],[-4,1,3],[-4,2,2],[-2,-2,4],[-2,0,2]] },
    { "input": [[-100000,0,100000]], "expected": [[-100000,0,100000]] },
    { "input_py": "[[0] * 3000]", "expected": [[0,0,0]] },
    { "input_py": "[[-1, 0, 1] * 1000]", "expected": [[-1,0,1],[0,0,0]] }
  ]
}
